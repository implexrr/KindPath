{
  "name": "kindpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "tsx --test server/app.test.ts server/scanner/*.test.ts src/components/visualEffects.test.ts src/components/reportExport.test.ts src/components/sitePreview.test.ts src/components/scanFeedback.test.ts",
    "scanner:build": "node scripts/build-scanner.mjs",
    "test:scanner": "tsx --test server/scanner.integration.ts",
    "test:gateway:unit": "node scripts/test-gateway-unit.mjs",
    "test:gateway": "tsx --test server/publicScanner.integration.ts",
    "test:firewall": "tsx --test server/firewall.integration.ts",
    "test:preview": "tsx --test server/preview.integration.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
